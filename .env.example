# Get a free key at https://www.themoviedb.org/settings/api
# Use either the v3 API key or the v4 read access token.
TMDB_API_KEY=
# TMDB_READ_TOKEN=

# Optional
# TMDB_REGION=DK
# TMDB_LANGUAGE=en-US        # e.g. da-DK for Danish titles/descriptions
# PORT=3001
# DB_FILE=data/movie-picker.db
# COOKIE_SECURE=true         # set when served over HTTPS
