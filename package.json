{
  "name": "movie-picker",
  "version": "1.0.0",
  "description": "Pick what to watch on movie night",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch --disable-warning=ExperimentalWarning server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saltlakrids/movie-picker.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/saltlakrids/movie-picker/issues"
  },
  "homepage": "https://github.com/saltlakrids/movie-picker#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
